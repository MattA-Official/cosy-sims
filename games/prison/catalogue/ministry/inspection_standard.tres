[resource]
script = ExtResource("1_def")
id = &"standard"
checks = Array[ExtResource("2_check")]([SubResource("Check_rooms"), SubResource("Check_cleaning"), SubResource("Check_meals"), SubResource("Check_staffing"), SubResource("Check_health"), SubResource("Check_safety")])
allowed_fails = 1

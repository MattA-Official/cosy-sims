[resource]
script = ExtResource("1_def")
id = &"handyman"
display_name = "Handyman"
description = "Unloads deliveries into the kitchen and stores, mends broken things and builds what you plan."
job_kinds = Array[StringName]([&"carry", &"repair", &"build"])
outfit_colour = Color(0.44, 0.4, 0.32, 1)
icon = ExtResource("2_icon")

[resource]
script = ExtResource("1_def")
id = &"calm_minds"
display_name = "Calm Minds"
description = "Talking therapy with a counsellor in a counselling room. Each session calms them for a few days; a pass for the rest of their stay."
icon = ExtResource("2_icon")
room_type = &"counselling"
teacher_role = &"counsellor"
teacher_tag = &"armchair"
student_tag = &"armchair"
sessions = 5
session_minutes = 90.0
skill = &""
trait_bonus = Dictionary[StringName, float]({&"hothead": -0.1, &"gentle": 0.1})
session_source = &"therapy_session"
after_pass = &"calmer"

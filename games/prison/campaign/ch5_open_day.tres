[sub_resource type="Resource" id="line_0"]
script = ExtResource("3_line")
who = &"pennywhistle"
trigger = &"start"
words = "The town has questions, Warden, and the paper prints all of them. Open the doors, show them what you do, and send people home better than they came."

[sub_resource type="Resource" id="line_1"]
script = ExtResource("3_line")
who = &"stan"
trigger = &"start"
words = "Classes, counselling and a kind word. Set an open day in the office when the place looks its best."

[sub_resource type="Resource" id="line_2"]
script = ExtResource("3_line")
who = &"gage"
trigger = &"first:inspection"
words = "A fair inspection. I've written it all down, as I always do."

[sub_resource type="Resource" id="line_3"]
script = ExtResource("3_line")
who = &"stan"
trigger = &"first:bad_news"
words = "Bad headline in the paper. Don't let it get you down; good news travels too."

[sub_resource type="Resource" id="line_4"]
script = ExtResource("3_line")
who = &"stan"
trigger = &"nudge"
words = "The town's not won over yet. A tidy place and a good open day change minds."

[sub_resource type="Resource" id="line_5"]
script = ExtResource("3_line")
who = &"pennywhistle"
trigger = &"won"
words = "The town is proud of its prison, and so is the Ministry. That's the last of my letters, Warden. Carry on as long as you like."

[sub_resource type="Resource" id="line_6"]
script = ExtResource("3_line")
who = &"stan"
trigger = &"won"
words = "Thirty-one years now. Best one yet."

[resource]
